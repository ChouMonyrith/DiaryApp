@model DiaryEntry

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2>Create Diary</h2>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="All" class="text-bg-danger"></div>
                    <form asp-action="Store" method="post">
                        <div class="form-group mb-3">
                            <label class="form-label" asp-for="Title">Title</label>
                            <input asp-for="Title" class="form-control" placeholder="Title" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label" asp-for="Content">Content</label>
                            <input type="text" asp-for="Content" row="5" class="form-control" placeholder="How was your day?" />
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label" asp-for="Created">Date</label>
                            <input asp-for="Created" class="form-control" type="date" placeholder="Title" />
                            <span asp-validation-for="Created" class="text-danger"></span>
                        </div>
                        <div class="d-flex justify-content-between ">
                            <button type="submit" class="btn btn-primary">Create</button>
                            <a asp-controller="DiaryEntry" asp-action="Index" class="btn btn-danger">Cancel</a>
                        </div>
                        
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial"/>
}